*

!Dockerfile
!.dockerignore

!mix.exs
!mix.lock
!VERSION
!config/
!/rel/
!/apps/
!/astarte-dashboard/

# Standard Elixir gitignore to be applied to all apps
**/_build/
**/cover/
**/deps/
apps/*/doc
**/.fetch
**/db
**/erl_crash.dump
**/*.ez
**/*.beam
**/config/*.secret.exs
**/.elixir_ls/
**/.lexical/
**/.expert/

# Standard Erlang gitignore to be applied to all apps
**/.eunit
**/*.o
**/*.beam
**/*.plt
**/.concrete/DEV_MODE
**/erl_crash.dump

# rebar 2.x
**/.rebar
**/rel/example_project
**/ebin/*.beam

# tools
**/.direnv/
**/.envrc
**/.helix
**/.nix-mix/
**/.nix-hex/
